# ============================================
# Maven
# ============================================
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/.gradle-enterprise/

# Mantener el Maven Wrapper (mvnw, mvnw.cmd y .mvn/wrapper)
!.mvn/wrapper/maven-wrapper.jar
!.mvn/wrapper/maven-wrapper.properties

# ============================================
# Java / compilados / empaquetados
# ============================================
*.class
*.log
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*

# Excepción: el wrapper de Maven sí se versiona
!**/.mvn/wrapper/maven-wrapper.jar

# ============================================
# Tomcat (si lo lanzas desde el workspace)
# ============================================
/logs/
/temp/
/work/
catalina.base/
catalina.home/
.tomcat/
*.pid

# ============================================
# VS Code (se versiona solo la config compartible)
# ============================================
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# ============================================
# Extensión Java de VS Code / Eclipse
# ============================================
.classpath
.project
.settings/
.factorypath
.apt_generated/
.apt_generated_tests/
bin/

# ============================================
# IntelliJ IDEA
# ============================================
.idea/
*.iml
*.iws
*.ipr
out/

# ============================================
# NetBeans
# ============================================
nbproject/private/
nbbuild/
nbdist/
nbactions.xml
nb-configuration.xml

# ============================================
